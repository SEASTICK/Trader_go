{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraderGO Universe",
  "version": "0.1.0",
  "identifier": "com.seastick.tradergo.universe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraderGO Universe",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMThFQjZDQ0I5MDg4MkYKUldRdmlKRExiT3NZN0o3aWxjUURjUmFQN3Y5RDRVc2xjMVBKdWpxWTJzdHlKdFZjUjlvRzBuNHQK",
      "endpoints": [
        "https://seastick.github.io/trader-go-releases/universe/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "tradergo-universe"
}
