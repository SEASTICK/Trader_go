[Unit]
Description=Trader_go forskningsworker (bara papper och publik marknadsdata)
ConditionPathExists=/etc/tradergo/legacy-worker-explicitly-disabled
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradergo
Group=tradergo
WorkingDirectory=/opt/tradergo/engine
EnvironmentFile=/etc/tradergo/worker.env
Environment=TRADERGO_REPO=/opt/tradergo
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/false
Restart=always
RestartSec=10
MemoryMax=3G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
